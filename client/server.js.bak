app.post('/api/update-policy-internal', requireAuth, async (req, res) => {
  const { maxBuySol, dailyLimitSol, isActive } = req.body;
  try {
    
    const tx = await program.methods
      .updatePolicy(new BN(maxBuySol), new BN(dailyLimitSol), isActive)
      .accounts({ owner: agentKeypair.publicKey, policy: policyPda })
      .rpc();
    res.json({ ok: true, tx, explorer: `https://explorer.solana.com/tx/${tx}?cluster=devnet` });
  } catch (e) {
    res.status(400).json({ ok: false, error: e.message });
  }
});
