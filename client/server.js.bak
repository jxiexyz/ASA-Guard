// ── Solana setup ──────────────────────────────────────────────────────────────
const connection = new Connection(RPC, "confirmed");
const rawKey = JSON.parse(readFileSync(`${homedir()}/.config/solana/id.json`, "utf8"));
const agentKeypair = Keypair.fromSecretKey(new Uint8Array(rawKey));
const agentWallet = new anchor.Wallet(agentKeypair);
const provider = new anchor.AnchorProvider(connection, agentWallet, { commitment: "confirmed" });
anchor.setProvider(provider);
const program = new anchor.Program(IDL, provider);

const ownerPubkey = agentKeypair.publicKey; // same keypair for devnet
const [policyPda] = PublicKey.findProgramAddressSync(
  [Buffer.from("policy"), ownerPubkey.toBuffer()],
  PROGRAM_ID
);

console.log("🔗 Connected to Solana devnet");
console.log("👤 Agent:", agentKeypair.publicKey.toBase58());
console.log("📋 Policy PDA:", policyPda.toBase58());

// ── Telegram auth verify ──────────────────────────────────────────────────────
function verifyTelegramAuth(data) {
  if (data.hash === "demo") return true;
  const { hash, ...fields } = data;
  const checkString = Object.keys(fields)
    .sort()
    .map((k) => `${k}=${fields[k]}`)
    .join("\n");
  const secretKey = createHash("sha256").update(BOT_TOKEN).digest();
  const hmac = createHmac("sha256", secretKey).update(checkString).digest("hex");
  if (hmac !== hash) return false;
  // check timestamp tidak lebih dari 1 hari
  const authDate = parseInt(fields.auth_date);
  if (Date.now() / 1000 - authDate > 86400) return false;
  return true;
}

// ── In-memory session (untuk dev) ────────────────────────────────────────────
const sessions = new Map();

// ── Pending login approvals ──────────────────────────────────────────────────
const pendingLogins = new Map(); // token → { username, resolve }

// POST /api/auth/request — minta approval via Telegram
app.post("/api/auth/request", async (req, res) => {
  const { username } = req.body;
  if (!username) return res.status(400).json({ error: "Username required" });
  const allowedUser = process.env.TELEGRAM_USERNAME;
  if (allowedUser && username.toLowerCase() !== allowedUser.toLowerCase()) {
    return res.status(401).json({ error: "Unauthorized user" });
  }
  const reqToken = createHash("sha256").update(`${username}:${Date.now()}`).digest("hex").slice(0, 16);
  // Kirim notif ke Telegram
  const CHAT_ID = process.env.TELEGRAM_CHAT_ID;
  const BOT = process.env.TELEGRAM_BOT_TOKEN;
  await axios.post(`https://api.telegram.org/bot${BOT}/sendMessage`, {
    chat_id: CHAT_ID,
    text: `🔐 *Login Request*\n\nUser: @${username}\nTime: ${new Date().toLocaleString()}\n\nApprove access to ASA Guard dashboard?`,
    parse_mode: 'Markdown',
    reply_markup: {
      inline_keyboard: [[
        { text: '✅ Approve', callback_data: `approve_login:${reqToken}` },
        { text: '❌ Reject', callback_data: `reject_login:${reqToken}` }
      ]]
    }
  }, { httpsAgent });
  // Tunggu approval max 60 detik
  const result = await new Promise((resolve) => {
    pendingLogins.set(reqToken, { username, resolve });
    setTimeout(() => {
      if (pendingLogins.has(reqToken)) {
        pendingLogins.delete(reqToken);
        resolve({ approved: false, reason: 'timeout' });
      }
    }, 60000);
  });
  if (!result.approved) {
    return res.status(401).json({ error: result.reason === 'timeout' ? 'Request timeout' : 'Rejected by owner' });
  }
  // Buat session
  const sessionToken = createHash("sha256").update(`${username}:${Date.now()}:${BOT}`).digest("hex");
  sessions.set(sessionToken, { username, loginAt: Date.now() });
  console.log(`✅ Login approved: @${username}`);
  res.json({ ok: true, token: sessionToken, user: { username } });
});

// POST /api/auth/callback — dipanggil dari telegram-bot waktu approve/reject
app.post("/api/auth/callback", (req, res) => {
  const { token, approved } = req.body;
  const secret = req.headers['x-internal-secret'];
  if (secret !== process.env.INTERNAL_SECRET) return res.status(403).json({ error: 'Forbidden' });
  const pending = pendingLogins.get(token);
  if (!pending) return res.status(404).json({ error: 'Token not found or expired' });
  pending.resolve({ approved });
  pendingLogins.delete(token);
  res.json({ ok: true });
});

// ── ROUTES ────────────────────────────────────────────────────────────────────

// POST /api/auth/telegram — verifikasi login Telegram
app.post("/api/auth/telegram", (req, res) => {
  const data = req.body;
  if (!data || !data.hash) {
    return res.status(400).json({ error: "Invalid auth data" });
  }
  const allowedUser = process.env.TELEGRAM_USERNAME;
  if (allowedUser && data.username !== allowedUser) {
    return res.status(401).json({ error: "Unauthorized user" });
  }
  if (!verifyTelegramAuth(data)) {
    return res.status(401).json({ error: "Invalid Telegram auth" });
  }
  const sessionToken = createHash("sha256")
    .update(`${data.id}:${data.auth_date}:${BOT_TOKEN}`)
    .digest("hex");
  sessions.set(sessionToken, {
    telegramId: data.id,
    username: data.username,
    firstName: data.first_name,
    photo: data.photo_url,
    loginAt: Date.now(),
  });
  console.log(`✅ Telegram login: @${data.username} (${data.id})`);
  res.json({ ok: true, token: sessionToken, user: { id: data.id, username: data.username, firstName: data.first_name, photo: data.photo_url } });
});

// GET /api/metrics
app.get("/api/metrics", requireAuth, (req, res) => {
  const history = global.tradeHistory || [];
  const approved = history.filter(t => t.approved).length;
  const rejected = history.filter(t => !t.approved).length;
  res.json({
    ok: true,
    totalTrades: history.length,
    approved,
    rejected,
    agent: agentKeypair.publicKey.toBase58(),
    policyPda: policyPda.toBase58()
  });
});

// GET /api/history — trade history
app.get("/api/history", requireAuth, (req, res) => {
  const history = global.tradeHistory || [];
  res.json({ ok: true, trades: history.slice(-20).reverse() });
});

// GET /api/config — expose wallet addresses ke dashboard
app.get("/api/config", requireAuth, (req, res) => {
  res.json({
    ok: true,
    dwalletId: process.env.DWALLET_ID || "0x13ed...3e2e",
    dwalletCap: process.env.DWALLET_CAP || "0xd659...0d05",
    programId: process.env.PROGRAM_ID || "Di3vEFGxT7LJbSfpXyyZTeo2PEHEb8oXK4xRuMCY7Qdd",
    network: "Solana Devnet"
  });
});

// Middleware: cek session token
function requireAuth(req, res, next) {
  const token = req.headers.authorization?.replace("Bearer ", "");
  const INTERNAL = process.env.INTERNAL_SECRET || "asa-guard-internal";
  if (token === INTERNAL) return next();
  if (!token || !sessions.has(token)) {
    return res.status(401).json({ error: "Unauthorized — login via Telegram" });
  }
  req.user = sessions.get(token);
  next();
}

// GET /api/policy — fetch policy on-chain
app.get("/api/policy", requireAuth, async (req, res) => {
  try {
    const policy = await program.account.agentPolicy.fetch(policyPda);
    res.json({
      ok: true,
      policy: {
        owner: policy.owner.toBase58(),
        agent: policy.agent.toBase58(),
        maxBuySol: policy.maxBuySol.toString(),
        dailyLimitSol: policy.dailyLimitSol.toString(),
        dailySpent: policy.dailySpent.toString(),
        stopLossBps: policy.stopLossBps,
        takeProfitBps: policy.takeProfitBps,
        tradeCount: policy.tradeCount,
        isActive: policy.isActive,
        lastReset: policy.lastReset.toString(),
      },
    });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// POST /api/approve-trade — server sign approveTrade
// body: { amountLamports: string }
app.post("/api/approve-trade", requireAuth, async (req, res) => {
  const { amountLamports } = req.body;
  if (!amountLamports) {
    return res.status(400).json({ error: "amountLamports required" });
  }
  try {
    
    const tx = await program.methods
      .approveTrade(new BN(amountLamports))
      .accounts({ agent: agentKeypair.publicKey, policy: policyPda })
      .rpc();
    console.log(`✅ approveTrade OK — ${amountLamports} lamports — tx: ${tx}`);
    if (!global.tradeHistory) global.tradeHistory = [];
    global.tradeHistory.push({
      token: req.body.token || 'SOL',
      action: req.body.action || 'BUY',
      amountSol: (parseInt(amountLamports) / 1e9).toFixed(4),
      approved: true,
      signature: tx,
      timestamp: Date.now()
    });
    res.json({
      ok: true,
      tx,
      explorer: `https://explorer.solana.com/tx/${tx}?cluster=devnet`,
    });
  } catch (e) {
    const errMsg = e?.error?.errorMessage || e.message;
    console.log(`❌ approveTrade REJECTED — ${errMsg}`);
    if (!global.tradeHistory) global.tradeHistory = [];
    global.tradeHistory.push({
      token: req.body.token || 'SOL',
      action: req.body.action || 'BUY',
      amountSol: (parseInt(amountLamports) / 1e9).toFixed(4),
      approved: false,
      signature: null,
      timestamp: Date.now()
    });
    res.status(400).json({ ok: false, error: errMsg });
  }
});

// POST /api/build-update-policy — build tx untuk user sign via Phantom
// body: { maxBuySol, dailyLimitSol, isActive, feePayer (pubkey string) }
app.post("/api/build-update-policy", requireAuth, async (req, res) => {
  const { maxBuySol, dailyLimitSol, isActive, feePayer } = req.body;
  if (!maxBuySol || !dailyLimitSol || isActive === undefined || !feePayer) {
    return res.status(400).json({ error: "maxBuySol, dailyLimitSol, isActive, feePayer required" });
  }
  try {
    
    const feePayerPubkey = new PublicKey(feePayer);
    const ix = await program.methods
      .updatePolicy(new BN(maxBuySol), new BN(dailyLimitSol), isActive)
      .accounts({ owner: feePayerPubkey, policy: policyPda })
      .instruction();
    const { blockhash } = await connection.getLatestBlockhash();
    const tx = new Transaction();
    tx.recentBlockhash = blockhash;
    tx.feePayer = feePayerPubkey;
    tx.add(ix);
    const serialized = tx.serialize({ requireAllSignatures: false });
    res.json({ ok: true, tx: Buffer.from(serialized).toString("base64") });
  } catch (e) {
    res.status(500).json({ ok: false, error: e.message });
  }
});

// GET /api/health
app.get("/api/health", (req, res) => {
  res.json({
    ok: true,
    agent: agentKeypair.publicKey.toBase58(),
    policyPda: policyPda.toBase58(),
